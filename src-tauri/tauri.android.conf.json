{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sisyphus",
  "version": "0.1.0",
  "identifier": "com.interviewkit.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sisyphus",
